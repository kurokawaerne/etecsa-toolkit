<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme (core-splashscreen): gradient brand background,
         animated signal mark, then the app theme takes over. -->
    <style name="Theme.Etk.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0057A8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Etk</item>
    </style>
    <style name="Theme.Etk" parent="android:Theme.Material.NoActionBar" />
</resources>
